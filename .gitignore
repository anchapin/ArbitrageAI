# =============================================================================
# ArbitrageAI - .gitignore
# =============================================================================
# Comprehensive .gitignore to prevent accidental commits of sensitive files,
# build artifacts, and development environment files
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.test
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
test-venv/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# -----------------------------------------------------------------------------
# Node.js (Client Portal)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log
yarn-error.log
lerna-debug.log
package-lock.json
yarn.lock

# Client portal build output
src/client_portal/dist/
src/client_portal/dist-ssr/
src/client_portal/build/
src/client_portal/.vite/

# Client portal environment
src/client_portal/.env.local
src/client_portal/.env.*.local

# -----------------------------------------------------------------------------
# Database Files
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
*.db-shm
*.db-wal

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Docker daemon config (may contain sensitive info)
daemon.json

# Docker volume files
*.volume

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
dump.rdb
redis.pid
redis.sock

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
.aws/
*.aws/credentials
*.aws/config

# -----------------------------------------------------------------------------
# Certificates and Keys (Security Critical)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
tmp/
temp/
.tmp/
*.tmp
*.temp
.cache/
.thumbnails/

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
fseventsd/
*.Spotlight-V100-*/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*/
.Trash-*/
.nfs*/

# -----------------------------------------------------------------------------
# Backup Files
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*~
*.orig
*.patch
*.diff

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Ruff
.ruff_cache/

# Black
.black/

# isort
.isort.cache

# Flake8
.flake8

# Pylint
.pylint.d/

# Bandit
.bandit.json

# Gitleaks
.gitleaks.json

# -----------------------------------------------------------------------------
# Documentation Build Output
# -----------------------------------------------------------------------------
docs/_build/
docs/build/
site/

# -----------------------------------------------------------------------------
# Scripts Output
# -----------------------------------------------------------------------------
scripts/output/
scripts/results/
*.out
*.results

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Application specific logs
*.log.*

# Lock files that should be platform-specific
poetry.lock

# Terraform
*.tfstate
*.tfstate.backup
.terraform/

# Ansible
*.retry

# Vagrant
.vagrant/

# VirtualBox
*.vbox-*

# Parallels
*.hdd

# VMware
*.vmware/

# -----------------------------------------------------------------------------
# Files that should NOT be ignored (exceptions)
# -----------------------------------------------------------------------------
# Keep README and important docs
!README.md
!LICENSE
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md

# Keep pyproject.toml and requirements
!pyproject.toml
!requirements.txt

# Keep Dockerfile
!Dockerfile
!Dockerfile.*
!docker-compose*.yml

# Keep important configs
!.pre-commit-config.yaml
!justfile

# -----------------------------------------------------------------------------
# End of .gitignore
# -----------------------------------------------------------------------------
